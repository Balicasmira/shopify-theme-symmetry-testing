        "custom_liquid_KdTKVh": {
          "type": "custom-liquid",
          "settings": {
            "custom_liquid": "<!-- SIZE GUIDE BUTTON -->\n<b><button class=\"pz-size-btn\" onclick=\"openSizeGuide()\" type=\"button\">\n  SIZE GUIDE ( CHART) </button></b>\n \n<!-- OVERLAY -->\n<div id=\"pzOverlay\" class=\"pz-overlay\">\n \n  <div class=\"pz-modal\">\n \n    <button class=\"pz-close\" onclick=\"openSizeGuide()\">✕</button>\n \n    <div class=\"pz-header\">\n      <h2>Size Guide</h2>\n      <p>Find your perfect fit</p>\n    </div>\n \n    <!-- TABS -->\n    <div class=\"pz-tabs\">\n      <button class=\"pz-tab active\" onclick=\"switchTab('sm')\">S / M / L / XL</button>\n      <button class=\"pz-tab\" onclick=\"switchTab('uk')\">UK / EU</button>\n      <button class=\"pz-tab\" onclick=\"switchTab('measure')\">How to Measure</button>\n    </div>\n \n    <!-- S M L TAB -->\n    <div id=\"pz-sm\" class=\"pz-content active\">\n      <table>\n        <tr><th>Size</th><th>UK</th><th>EU</th><th>Bust (cm)</th><th>Waist (cm)</th><th>Hip (cm)</th></tr>\n        <tr><td>XS</td><td>6</td><td>34</td><td>80–84</td><td>61–65</td><td>88–92</td></tr>\n        <tr><td>S</td><td>8</td><td>36</td><td>85–89</td><td>66–70</td><td>93–97</td></tr>\n        <tr><td>M</td><td>10</td><td>38</td><td>90–94</td><td>71–75</td><td>98–102</td></tr>\n        <tr><td>L</td><td>12</td><td>40</td><td>95–99</td><td>76–80</td><td>103–107</td></tr>\n        <tr><td>XL</td><td>14</td><td>42</td><td>100–104</td><td>81–85</td><td>108–112</td></tr>\n        <tr><td>XXL</td><td>16</td><td>44</td><td>105–109</td><td>86–90</td><td>113–117</td></tr>\n      </table>\n      <p class=\"pz-note\">*If between sizes, choose based on desired fit (tight vs relaxed).</p>\n    </div>\n \n    <!-- UK EU TAB -->\n    <div id=\"pz-uk\" class=\"pz-content\">\n      <table>\n        <tr><th>UK</th><th>EU</th><th>US</th></tr>\n        <tr><td>6</td><td>34</td><td>2</td></tr>\n        <tr><td>8</td><td>36</td><td>4</td></tr>\n        <tr><td>10</td><td>38</td><td>6</td></tr>\n        <tr><td>12</td><td>40</td><td>8</td></tr>\n        <tr><td>14</td><td>42</td><td>10</td></tr>\n        <tr><td>16</td><td>44</td><td>12</td></tr>\n        <tr><td>18</td><td>46</td><td>14</td></tr>\n      </table>\n    </div>\n \n    <!-- HOW TO MEASURE -->\n    <div id=\"pz-measure\" class=\"pz-content\">\n      <div class=\"pz-text\">\n        <h4>Bust</h4>\n        <p>Measure around the fullest part of your chest.</p>\n \n        <h4>Waist</h4>\n        <p>Measure around the narrowest part of your waist.</p>\n \n        <h4>Hip</h4>\n        <p>Measure around the widest part of your hips.</p>\n      </div>\n    </div>\n \n  </div>\n</div>\n \n<style>\n/* BUTTON */\n.pz-size-btn{\n  font-size:13px;\n  text-decoration:underline;\n  background:none;\n  border:none;\n  cursor:pointer;\n  color:#BC3909;\n  margin-top:10px;\n}\n \n/* OVERLAY */\n.pz-overlay{\n  position:fixed;\n  inset:0;\n  background:rgba(0,0,0,.45);\n  display:none;\n  align-items:center;\n  justify-content:center;\n  z-index:9999;\n}\n \n.pz-overlay.active{ display:flex; }\n \n/* MODAL */\n.pz-modal{\n  width:92%;\n  max-width:720px;\n  background:#fff;\n  border-radius:14px;\n  padding:28px;\n  position:relative;\n  animation:fadeUp .25s ease;\n}\n \n@keyframes fadeUp{\n  from{ transform:translateY(20px); opacity:0; }\n  to{ transform:translateY(0); opacity:1; }\n}\n \n/* HEADER */\n.pz-header h2{\n  margin:0;\n  font-size:20px;\n  font-weight:500;\n}\n.pz-header p{\n  margin:4px 0 18px;\n  font-size:13px;\n  color:#777;\n}\n \n/* CLOSE */\n.pz-close{\n  position:absolute;\n  top:14px;\n  right:16px;\n  background:none;\n  border:none;\n  font-size:18px;\n  cursor:pointer;\n}\n \n/* TABS */\n.pz-tabs{\n  display:flex;\n  border-bottom:1px solid #eee;\n  margin-bottom:16px;\n}\n \n.pz-tab{\n  flex:1;\n  padding:10px;\n  font-size:13px;\n  border:none;\n  background:none;\n  cursor:pointer;\n  color:#888;\n}\n \n.pz-tab.active{\n  color:#111;\n  border-bottom:2px solid #111;\n}\n \n/* CONTENT */\n.pz-content{ display:none; }\n.pz-content.active{ display:block; }\n \n/* TABLE */\ntable{\n  width:100%;\n  border-collapse:collapse;\n  font-size:13px;\n}\n \nth,td{\n  padding:10px 6px;\n  border-bottom:1px solid #eee;\n  text-align:left;\n}\n \nth{ font-weight:500; color:#111; }\ntd{ color:#555; }\n \n/* NOTES */\n.pz-note{\n  font-size:11px;\n  color:#888;\n  margin-top:10px;\n}\n \n/* TEXT BLOCK */\n.pz-text h4{\n  margin:12px 0 4px;\n  font-size:13px;\n}\n \n.pz-text p{\n  margin:0;\n  font-size:13px;\n  color:#666;\n}\n</style>\n \n<script>\nfunction openSizeGuide(){\n  document.getElementById(\"pzOverlay\").classList.toggle(\"active\");\n}\n \nfunction switchTab(tab){\n  document.querySelectorAll(\".pz-content\").forEach(e=>e.classList.remove(\"active\"));\n  document.querySelectorAll(\".pz-tab\").forEach(e=>e.classList.remove(\"active\"));\n \n  document.getElementById(\"pz-\"+tab).classList.add(\"active\");\n  event.target.classList.add(\"active\");\n}\n \ndocument.getElementById(\"pzOverlay\").addEventListener(\"click\", function(e){\n  if(e.target === this){\n    this.classList.remove(\"active\");\n  }\n});\n \ndocument.addEventListener(\"keydown\", function(e){\n  if(e.key === \"Escape\"){\n    document.getElementById(\"pzOverlay\").classList.remove(\"active\");\n  }\n});\n</script>",
